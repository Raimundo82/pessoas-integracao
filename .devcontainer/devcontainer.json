// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet-postgres
{
  "name": "C# (.NET) and PostgreSQL",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "customizations": {
    "vscode": {
      "settings": {
        "plantuml.server": "https://www.plantuml.com/plantuml",
        "sonarlint.pathToNodeExecutable": "/usr/local/share/nvm/versions/node/v24.14.1/bin/node",
        "dotnet.preferCSharpExtension": false
      },
      "extensions": [
        // .NET Development
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        // Database
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        // Code Quality & Analysis
        "SonarSource.sonarlint-vscode",
        "hbenl.vscode-test-explorer",
        // Formatting & Linting
        "esbenp.prettier-vscode",
        "EditorConfig.EditorConfig",
        // Documentation & Diagrams
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint",
        "jebbs.plantuml",
        // Other Tools
        "me-dutour-mathieu.vscode-github-actions"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2.5.0": {
      "version": "10.0.201"
    },
    "ghcr.io/devcontainers/features/node:1.7.1": {
      "version": "24.14.1"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.9.1": {
      "dockerDashComposeVersion": "none"
    }
  },
  "remoteEnv": {
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal"
  },
  "postCreateCommand": "bash .devcontainer/post-script.sh"
}
