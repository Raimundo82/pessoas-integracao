{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "nuget",
    "npm"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "groupName": "hotchocolate monorepo",
      "matchPackageNames": [
        "HotChocolate",
        "/^HotChocolate\\./"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ]
    },
    {
      "groupName": "keycloak authservices monorepo",
      "matchPackageNames": [
        "/^Keycloak\\.AuthServices\\./"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ]
    },
    {
      "extends": [
        "monorepo:dotnet"
      ],
      "groupName": "dotnet monorepo",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ]
    },
    {
      "groupName": "npm dev tooling",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "groupName": "npm dev tooling major",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "groupName": "dotnet tools",
      "matchFileNames": [
        "**/.config/dotnet-tools.json"
      ],
      "rangeStrategy": "replace"
    },
    {
      "groupName": "devcontainer",
      "matchManagers": [
        "devcontainer"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ]
    },
    {
      "groupName": "dockerfile base images",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ]
    },
    {
      "matchManagers": [
        "dockerfile",
        "devcontainer"
      ],
      "digest": {
        "enabled": false
      }
    }
  ]
}