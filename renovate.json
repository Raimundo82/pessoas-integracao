{
    "extends": [
        "config:recommended"
    ],
    "enabledManagers": [
        "nuget"
    ],
    "rangeStrategy": "bump",
    "packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ],
            "automerge": true
        }
    ]
}