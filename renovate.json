{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "nuget",
    "npm",
    "dockerfile",
    "devcontainer"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "groupName": "hotchocolate monorepo",
      "matchPackageNames": [
        "HotChocolate",
        "/^HotChocolate\\./"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ]
    },
    {
      "groupName": "keycloak authservices monorepo",
      "matchPackageNames": [
        "/^Keycloak\\.AuthServices\\./"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ]
    },
    {
      "extends": [
        "monorepo:dotnet"
      ],
      "groupName": "dotnet monorepo",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ]
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchFileNames": [
        "global.json",
        ".devcontainer/devcontainer.json"
      ],
      "groupName": "minor dev tooling",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchFileNames": [
        "global.json",
        ".devcontainer/devcontainer.json"
      ],
      "groupName": "major dev tooling",
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "groupName": "dotnet tools",
      "matchFileNames": [
        "**/.config/dotnet-tools.json"
      ],
      "rangeStrategy": "replace"
    },
    {
      "matchManagers": [
        "dockerfile",
        "devcontainer"
      ],
      "digest": {
        "enabled": false
      }
    }
  ]
}