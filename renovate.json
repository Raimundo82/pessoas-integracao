{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>marinha-si/renovate-config:renovate"
  ],
  "enabledManagers": [
    "nuget",
    "npm"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "semanticCommitType": "chore"
    },
    {
      "matchDatasources": [
        "nuget"
      ],
      "matchFileNames": [
        "**/SigdnRhStaggingApi.csproj"
      ],
      "semanticCommitType": "fix"
    },
    {
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": [
        "Microsoft.EntityFrameworkCore.tools",
        "Microsoft.EntityFrameworkCore.design"
      ],
      "semanticCommitType": "chore"
    },
    {
      "groupName": "hotchocolate monorepo",
      "matchPackageNames": [
        "HotChocolate",
        "/^HotChocolate\\./"
      ],
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor",
        "major"
      ]
    },
    {
      "groupName": "keycloak authservices monorepo",
      "matchPackageNames": [
        "/^Keycloak\\.AuthServices\\./"
      ],
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor",
        "major"
      ]
    },
    {
      "extends": [
        "monorepo:dotnet"
      ],
      "groupName": "dotnet monorepo",
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor",
        "major"
      ]
    }
  ]
}