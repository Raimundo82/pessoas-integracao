{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "nuget",
    "npm",
    "dockerfile",
    "devcontainer"
  ],
  "rangeStrategy": "bump",
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "groupName": "minor hotchocolate monorepo",
      "matchPackageNames": [
        "/^HotChocolate\\./"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "groupName": "major hotchocolate monorepo",
      "matchPackageNames": [
        "/^HotChocolate\\./"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "groupName": "minor keycloak authservices monorepo",
      "matchPackageNames": [
        "/^Keycloak\\.AuthServices\\./"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "groupName": "major keycloak authservices monorepo",
      "matchPackageNames": [
        "/^Keycloak\\.AuthServices\\./"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "groupName": "coverlet monorepo",
      "matchPackageNames": [
        "^coverlet\\."
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "groupName": "major coverlet monorepo",
      "matchPackageNames": [
        "^coverlet\\."
      ],
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "extends": [
        "monorepo:dotnet"
      ],
      "groupName": "minor dotnet monorepo",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    },
    {
      "extends": [
        "monorepo:dotnet"
      ],
      "groupName": "major dotnet monorepo",
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "groupName": "dotnet tools",
      "matchFileNames": [
        "**/.config/dotnet-tools.json"
      ],
      "rangeStrategy": "replace"
    },
    {
      "matchManagers": [
        "dockerfile",
        "devcontainer"
      ],
      "digest": {
        "enabled": false
      }
    },
    {
      "matchManagers": [
        "devcontainer"
      ],
      "matchPackageNames": [
        "node"
      ],
      "enabled": false
    }
  ]
}