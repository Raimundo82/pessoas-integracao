{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "nuget",
    "npm",
    "dockerfile",
    "devcontainer"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "groupName": "hotchocolate monorepo",
      "matchPackageNames": [
        "HotChocolate**"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ]
    },
    {
      "groupName": "keycloak authservices monorepo",
      "matchPackageNames": [
        "/^Keycloak\\.AuthServices\\./"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ]
    },
    {
      "extends": [
        "monorepo:dotnet"
      ],
      "groupName": "dotnet monorepo",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ]
    },
        {
      "matchManagers": ["nuget"],
      "matchFileNames": ["global.json"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "minor dev tooling"
    },
    {
      "matchManagers": ["devcontainer"],
      "matchFileNames": [".devcontainer/devcontainer.json"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "minor dev tooling"
    },
    {
      "groupName": "dotnet tools",
      "matchFileNames": [
        "**/.config/dotnet-tools.json"
      ],
      "rangeStrategy": "replace"
    },
    {
      "matchManagers": [
        "dockerfile",
        "devcontainer"
      ],
      "digest": {
        "enabled": false
      }
    }
  ]
}