{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "format",
      "command": "dotnet",
      "filteringRule": "staged",
      "include": ["**/*.cs"],
      "args": ["format", "--include", "${staged}"]
    },
    {
      "name": "prettier",
      "command": "npx",
      "filteringRule": "staged",
      "args": ["prettier", "--ignore-unknown", "--write", "${staged}"]
    }
  ]
}
